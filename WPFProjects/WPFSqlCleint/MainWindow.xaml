<Window x:Class="WPFSqlCleint.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFSqlCleint"
        mc:Ignorable="d"
        Title="SQLClient" Height="600" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="100" MaxWidth="300"/>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TreeView x:Name="TablesTreeView"
                  Grid.Column="0"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Margin="5"
                  MouseDoubleClick="TablesTreeView_MouseDoubleClick">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Table" Click="ShowTableMenuItem_Click"/>
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>
        <GridSplitter
            Grid.Column="1"
            Grid.Row="0"
            Grid.RowSpan="2"
            Width="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="Gray"
            ShowsPreview="False" 
            ResizeBehavior="PreviousAndNext"
            />
        <StackPanel Grid.Column="2"
                    Grid.Row="0"
                    Orientation="Vertical"
                    Margin="5">
            <!--<Label Content="SQL Query"
                   VerticalAlignment="Center"
                   Background="#9e9e9e"/>-->
            <TextBox x:Name="SqlQueryTextBox"
                     Width="auto"
                     Height="80"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consoles"
                     FontSize="15"
                     VerticalAlignment="Center"
                     Text="Enter Query"
                     GotFocus="SqlQueryTextBox_GotFocus"
                     KeyDown="SqlQueryTextBox_KeyDown"/>

        </StackPanel>
        <DataGrid x:Name="ResultDataGrid"
                  Grid.Column="2"
                  Grid.Row="1"
                  Grid.RowSpan="2"
                  Width="auto"
                  Height="auto"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  Margin="5"/>   
    </Grid>
</Window>
    
